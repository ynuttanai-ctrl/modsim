{
  "name": "modbus-tcp-simulator",
  "version": "1.0.0",
  "description": "Configurable Modbus TCP simulator for testing Modbus masters such as Node-RED.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "test": "node --test test/analog.test.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.modsim.app",
    "productName": "Modbus TCP Simulator",
    "files": [
      "server.js",
      "electron-main.js",
      "public/**",
      "node_modules/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [
    "modbus",
    "modbus-tcp",
    "simulator",
    "nodered"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  }
}
