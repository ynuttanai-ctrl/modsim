  {
    "id": "f1b3c4d5e6f7a803",
    "type": "function",
    "z": "a2bfb7e7c7a00101",
    "name": "Decode μA → engineering value",
    "func": "var raw = Array.isArray(msg.payload) ? msg.payload\n    : (Array.isArray(msg.payload && msg.payload.data) ? msg.payload.data : []);\n\n// Edit these to match your simulator's Analog Channel configuration\nvar channels = [\n    { name: 'CH1', mode: 3, loReal: 0,   hiReal: 100, unit: 'bar' },\n    { name: 'CH2', mode: 3, loReal: -20, hiReal: 80,  unit: 'C'   }\n];\n\nvar decoded = [];\nfor (var i = 0; i < channels.length && i < raw.length; i++) {\n    var ch = channels[i];\n    var reg = raw[i];\n    var span = ch.hiReal - ch.loReal;\n    var value;\n    if      (ch.mode === 3) { value = (reg - 4000)  / 16000 * span + ch.loReal; }\n    else if (ch.mode === 2) { value =  reg           / 20000 * span + ch.loReal; }\n    else if (ch.mode === 0) { value =  reg           / 5000  * span + ch.loReal; }\n    else if (ch.mode === 1) { value = (reg - 1000)   / 4000  * span + ch.loReal; }\n    else                    { value =  reg; }\n    decoded.push({ name: ch.name, raw: reg, value: Math.round(value * 100) / 100, unit: ch.unit });\n}\n\nmsg.payload = { unitId: 3, analogChannels: decoded, timestamp: new Date().toISOString() };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 490,
    "y": 460,
    "wires": [
      [
        "f1b3c4d5e6f7a804"
      ]
    ]
  },
