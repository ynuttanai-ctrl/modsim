  {
    "id": "f1b3c4d5e6f7a801",
    "type": "comment",
    "z": "a2bfb7e7c7a00101",
    "name": "Analog 4-20mA — Unit 3 (add Slave Unit ID 3 + Analog Channels in simulator first)",
    "info": "Prerequisite: In the simulator UI, add a Slave device with Unit ID 3 on Gateway A,\nthen open the Analog tab and add channels.\n\nRegister map (matches Waveshare Modbus RTU Analog Input 8CH protocol):\n  FC04 input  0x0000–0x0007 : channel 0–7 data (μA for current, mV for voltage)\n  FC03 holding 0x1000–0x1007 : channel 0–7 mode (read)\n  FC06 holding 0x1000–0x1007 : channel 0–7 mode (write)\n\nMode values: 0=0~5V  1=1~5V  2=0~20mA  3=4~20mA  4=Raw ADC",
    "x": 370,
    "y": 400,
    "wires": []
  },
  {
    "id": "f1b3c4d5e6f7a802",
    "type": "modbus-read",
    "z": "a2bfb7e7c7a00101",
    "name": "Unit 3 Analog Data (FC4 input 0–7)",
    "topic": "unit3/analog",
    "showStatusActivities": true,
    "logIOActivities": false,
    "showErrors": true,
    "showWarnings": true,
    "unitid": "3",
    "dataType": "InputRegister",
    "adr": "0",
    "quantity": "8",
    "rate": "2",
    "rateUnit": "s",
    "delayOnStart": false,
    "startDelayTime": "",
    "server": "4b7e51628c23fbd1",
    "useIOFile": false,
