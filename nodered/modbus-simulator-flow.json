  {
    "id": "f1b3c4d5e6f7a806",
    "type": "function",
    "z": "a2bfb7e7c7a00101",
    "name": "Decode Mode Labels",
    "func": "var raw = Array.isArray(msg.payload) ? msg.payload\n    : (Array.isArray(msg.payload && msg.payload.data) ? msg.payload.data : []);\n\nvar MODE_LABELS = ['0~5V', '1~5V', '0~20mA', '4~20mA', 'Raw ADC'];\nvar modes = [];\nfor (var i = 0; i < raw.length; i++) {\n    var m = raw[i];\n    var hexAddr = '0x' + (0x1000 + i).toString(16).toUpperCase();\n    modes.push({ channel: i, holdingAddr: hexAddr, mode: m, label: MODE_LABELS[m] || 'unknown' });\n}\nmsg.payload = { unitId: 3, channelModes: modes, timestamp: new Date().toISOString() };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 500,
