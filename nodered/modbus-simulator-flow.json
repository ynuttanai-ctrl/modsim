  {
    "id": "6f423f649790e7e6",
    "type": "function",
    "z": "a2bfb7e7c7a00101",
    "name": "Scale Unit 1 A",
    "func": "const raw = Array.isArray(msg.payload)\n    ? msg.payload\n    : Array.isArray(msg.payload?.data)\n        ? msg.payload.data\n        : [];\n\nconst scale = 100;\nmsg.payload = {\n    unitId: 1,\n    table: \"holding\",\n    address: 0,\n    raw,\n    current: {\n        L1: raw[0] / scale,\n        L2: raw[1] / scale,\n        L3: raw[2] / scale\n    },\n    unit: \"A\",\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
